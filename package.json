{
  "name": "aws-node-ts-service-template",
  "version": "1.0.0",
  "private": true,
  "description": "Cost-conscious AWS Lambda service template: Node.js + TypeScript, hexagonal architecture and OOP design",
  "keywords": [
    "aws",
    "lambda",
    "serverless",
    "typescript",
    "hexagonal-architecture",
    "clean-architecture",
    "clean-code",
    "template"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "prepare": "husky || true",
    "start": "sam build --config-env development && sam local start-api --config-env development",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --colors --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --coverageDirectory .coverage --colors",
    "package": "sam validate --lint && sam build",
    "deploy": "sam build && sam deploy --config-env",
    "remove": "sam delete --config-env"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.0",
    "@types/aws-lambda": "^8.10.161",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.12.4",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.5",
    "ts-jest": "^29.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "lint-staged": {
    "**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
